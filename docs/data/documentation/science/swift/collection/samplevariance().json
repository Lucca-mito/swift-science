{"abstract":[{"text":"The sample variance of the collection.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Science\/documentation\/Science","doc:\/\/Science\/documentation\/Science\/Swift","doc:\/\/Science\/documentation\/Science\/Swift\/Collection"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Science\/documentation\/Science\/Swift\/Collection\/sampleVariance()"},"kind":"symbol","metadata":{"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"AlgebraicField","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Euclidean","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"IntegerApproximable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Element.Stride","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"AlgebraicField","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Element.Stride","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"IntegerApproximable","type":"codeVoice"},{"text":".","type":"text"}]},"extendedModule":"Swift","externalID":"s:Sl7Science10RealModule14AlgebraicField7ElementRpzAA9EuclideanAERQAA19IntegerApproximableAERQAbcD_6StrideAA11MetricSpacePRPzAagKRQrlE14sampleVarianceAKyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"sampleVariance"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"Self"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ST7ElementQa","text":"Element"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:7Science11MetricSpaceP6StrideQa","text":"Stride"}],"modules":[{"name":"Swift Science","relat