{"abstract":[{"text":"A two-sided hypothesis test using a normally-distributed parameter estimator.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Science\/documentation\/Science"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Science\/documentation\/Science\/WaldTest"},"kind":"symbol","metadata":{"externalID":"s:7Science8WaldTestV","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WaldTest"}],"modules":[{"name":"Swift Science"}],"navigatorTitle":[{"kind":"identifier","text":"WaldTest"}],"remoteSource":{"fileName":"WaldTest.swift","url":"https:\/\/github.com\/lucca-mito\/swift-science\/blob\/main\/Sources\/Science\/Statistics\/Hypothesis%20Testing\/Common%20Hypothesis%20Tests\/WaldTest.swift#L43"},"role":"symbol","roleHeading":"Structure","symbolKind":"struct","title":"WaldTest"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"WaldTest"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Sample"},{"kind":"text","text":">"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Use the Wald test only if the estimator ","type":"text"},{"code":"parameterEstimator","type":"codeVoice"},{"text":" of the parameter of interest 𝜃 is approximately normally-distributed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Wald test rejects the null hypothesis 𝜃 = 𝜃₀ (for some real number 𝜃₀) on dataset 𝑋 at level 𝛼 if:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"wald-test-rejection-condition.svg","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"where 𝚽⁻¹ is the standard normal ","type":"text"},{"identifier":"doc:\/\/Science\/documentation\/Science\/NormalDistribution\/quantile(_:)","isActive":true,"type":"reference"},{"text":" fu